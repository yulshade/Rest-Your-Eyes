/* Rest Your Eyes — dark translucent theme */

#card {
    background: rgba(22, 26, 34, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

QLabel {
    color: #e6e9ef;
    font-family: "Segoe UI", sans-serif;
}

#appTitle {
    color: #aeb6c4;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
}

#panelTitle {
    color: #8b94a6;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}

#bigValue {
    color: #ffffff;
    font-size: 30px;
    font-weight: 700;
}

#subValue {
    color: #aeb6c4;
    font-size: 12px;
}

#activeValue {
    color: #5cc8ff;
    font-size: 15px;
    font-weight: 600;
}

#idleValue {
    color: #8b94a6;
    font-size: 15px;
    font-weight: 600;
}

#separator {
    background: rgba(255, 255, 255, 0.07);
    max-height: 1px;
    min-height: 1px;
}

QProgressBar#ratioBar {
    background: rgba(255, 255, 255, 0.10);
    border: none;
    border-radius: 3px;
}
QProgressBar#ratioBar::chunk {
    background: #5cc8ff;
    border-radius: 3px;
}

/* ---- Calendar custom nav bar ---- */
QToolButton#calNav {
    color: #aeb6c4;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 700;
    padding: 2px 8px;
}
QToolButton#calNav:hover {
    background: rgba(255, 255, 255, 0.10);
    color: #ffffff;
}
QToolButton#calNav:pressed {
    background: rgba(255, 255, 255, 0.16);
}
QToolButton#calHeader {
    color: #e6e9ef;
    background: transparent;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    padding: 2px 10px;
}
QToolButton#calHeader:hover {
    background: rgba(255, 255, 255, 0.10);
}

/* ---- Calendar ---- */
QCalendarWidget #calendar {
    background: transparent;
}
QCalendarWidget QWidget {
    alternate-background-color: transparent;
    color: #e6e9ef;
}
QCalendarWidget QAbstractItemView {
    background: transparent;
    selection-background-color: #3a82f6;
    selection-color: #ffffff;
    outline: none;
    font-size: 12px;
}
QCalendarWidget QAbstractItemView:enabled {
    color: #d6dae3;
}
QCalendarWidget QAbstractItemView:disabled {
    color: #555c6b;
}
/* Navigation bar */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: transparent;
}
QCalendarWidget QToolButton {
    color: #e6e9ef;
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 600;
}
QCalendarWidget QToolButton:hover {
    background: rgba(255, 255, 255, 0.10);
}
QCalendarWidget QToolButton::menu-indicator {
    image: none;
}
QCalendarWidget QSpinBox {
    color: #e6e9ef;
    background: #232936;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 4px;
}
/* Day-of-week header row */
QCalendarWidget QTableView {
    border: none;
}
